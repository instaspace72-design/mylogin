# Copy to .env for local overrides, or set these in your host's dashboard.

# Port to listen on (most hosts set this automatically).
PORT=3000

# Where the JSON data file lives.
# Locally the default ./data/db.json is fine.
# On Railway/Render, point this at a mounted persistent volume:
# DATA_FILE=/data/db.json
DATA_FILE=./data/db.json

# Signs session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to production on your host so cookies are marked secure.
# NODE_ENV=production

# Set to 1 if running behind a proxy or load balancer.
# TRUST_PROXY=1
